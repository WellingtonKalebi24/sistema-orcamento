# API
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
UPLOAD_DIR=./backend/uploads
UPLOAD_MAX_BYTES=8388608
REQUEST_BODY_LIMIT=1mb

# PostgreSQL local
POSTGRES_USER=orcamento
POSTGRES_PASSWORD=orcamento_local
POSTGRES_DB=orcamento
DATABASE_URL=postgresql://orcamento:orcamento_local@localhost:5432/orcamento?schema=public
TEST_DATABASE_URL=postgresql://orcamento:orcamento_local@localhost:5433/orcamento_test?schema=public

# Authentication values are placeholders for local setup only.
JWT_PRIVATE_KEY=replace-with-private-key-in-foundational-phase
JWT_PUBLIC_KEY=replace-with-public-key-in-foundational-phase
JWT_ISSUER=sistema-orcamento
JWT_AUDIENCE=sistema-orcamento-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=replace-with-long-random-value
